# Dashboard login password (single shared secret, not a per-user account)
DASHBOARD_PASSWORD=

# Random long string used to sign the session cookie — not the same as the password above
SESSION_SECRET=

# GitHub personal access token, scoped to ONLY this repo, with "Contents: read and write" permission
GITHUB_TOKEN=

# Repo identifiers the dashboard commits to
GITHUB_OWNER=vector-10
GITHUB_REPO=portfolio-website
